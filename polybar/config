[bar/bar]
font-0 = JetBrains Mono:pixelsize=10;2
font-1 = Font Awesome 5 Free:size=10;2
font-2 = JetBrainsMono Nerd Font Mono:pixelsize=20;4
font-3 = Font Awesome 5 Free:size=7;1
monitor = ${env:MONITOR:eDP-1}
enable-ipc = true
scroll-up = i3wm-wsnext
scroll-down = i3wm-wsprev
fixed-center = true
width = 100%
height = 30
background = #1a1b26
foreground = #c0caf5
radius = 0
line-size = 3
padding-left = 0
padding-right = 1
module-margin = 1
tray-position = right
tray-padding = 2
modules-left = logo workspaces idle
modules-center = time date
modules-right = monitor brightness battery pulseaudio

[module/workspaces]
type = custom/script
exec = $HOME/.local/bin/workspaces.sh
tail = true
interval = 0

[module/date]
type = custom/script
exec = date '+%a, %b %d %Y' | tr 'A-Z' 'a-z'
interval = 30

[module/time]
type = internal/date
interval = 30
date = %H:%M

[module/pulseaudio]
type = internal/pulseaudio
use-ui-max = true
interval = 2
format-volume = <ramp-volume>
format-muted = <label-muted>
label-muted = 
label-muted-foreground = #565f89
ramp-volume-0 = 
ramp-volume-1 = 
ramp-volume-2 = 
ramp-headphones-0 = 
click-right = $HOME/.local/bin/audio-menu

[module/idle]
type = custom/script
exec = $HOME/.local/bin/idle-toggle.sh
interval = 2
click-right = $HOME/.local/bin/idle-toggle.sh toggle
format-padding = 1

[module/battery]
type = custom/script
exec = $HOME/.local/bin/battery.sh
interval = 30
click-right = $HOME/.local/bin/power-menu.sh
format-padding = 1

[module/monitor]
type = custom/text
content = 󰍹
content-padding = 1
content-foreground = #c0caf5
click-right = $HOME/.local/bin/display-menu

[module/brightness]
type = custom/script
exec = $HOME/.local/bin/brightness.sh
interval = 1
format = <label>
label = %output%
label-padding = 1
scroll-up = $HOME/.local/bin/brightness.sh up
scroll-down = $HOME/.local/bin/brightness.sh down
click-left = $HOME/.local/bin/brightness.sh up
click-right = $HOME/.local/bin/brightness.sh down

[module/logo]
type = custom/text
content = 
content-padding = 1
content-foreground = #7aa2f7
content-background = #24283b
