[global]
    width = 300
    height = 80
    origin = top-right
    offset = 12x40
    font = JetBrains Mono 10
    frame_width = 1
    frame_color = "#24283b"
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 280
    progress_bar_max_width = 280

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    timeout = 2
